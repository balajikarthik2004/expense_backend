# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/ledger_db
# For MongoDB Atlas use:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ledger_db?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this_in_production_min_32_chars
JWT_REFRESH_EXPIRE=30d

# CORS
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Backup cluster ─────────────────────────────────────────────
# Second Atlas cluster, in a separate project (one free M0 per project).
BACKUP_MONGO_URI=mongodb+srv://<user>:<pass>@backup0.xxxxx.mongodb.net/?retryWrites=true&w=majority
BACKUP_KEEP=12

# Only needed if Node cannot resolve SRV records on your network.
# DNS_SERVERS=8.8.8.8,1.1.1.1
